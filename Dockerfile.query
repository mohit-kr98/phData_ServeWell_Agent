FROM python:3.12-slim

WORKDIR /app

# Copy requirements and install using BuildKit cache to speed up builds
COPY requirements-query.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-query.txt

# Copy the rest of the application code
COPY . .

# Expose port
EXPOSE 8002

# Run the API service
CMD ["python", "services/query_pipeline.py"]
